# Copy to .env.local for development. Never commit a filled in file.

# Where the browser reaches this site. Used for canonical URLs and metadata.
# The canonical origin. Every absolute URL the site emits is built from this:
# canonical tags, Open Graph, the sitemap, robots, and structured data. Point it
# at the wrong host and a crawler indexes the wrong host.
NEXT_PUBLIC_SITE_ORIGIN=https://0xsemantic.com

# Where the frontend proxies /api to. Server side only, never sent to the browser.
# Use a literal address rather than "localhost": on most Linux hosts that
# resolves to ::1 first, while the API server binds IPv4.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Search engine ownership proofs. Both optional, both from the meta tag method
# offered by each tool. An empty value renders no tag at all, which is right:
# an empty verification tag reads as a claim that failed rather than one never
# made.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# The IndexNow key, matching INDEXNOW_KEY on the backend. This side serves it
# at /<key>.txt, which is how the protocol verifies that whoever submits
# addresses controls the site.
NEXT_PUBLIC_INDEXNOW_KEY=
